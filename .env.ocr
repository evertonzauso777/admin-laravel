# ========================
# CONFIGURAÇÃO OCR
# ========================

# URL da API OCR
# 
# Para ambientes diferentes:
# 
# ✅ LOCAL (sem Docker):
# OCR_API_URL=http://localhost:5000/ocr
#
# ✅ DOCKER WINDOWS/MAC (host.docker.internal):
# OCR_API_URL=http://host.docker.internal:5000/ocr
#
# ✅ DOCKER LINUX (172.17.0.1):
# OCR_API_URL=http://172.17.0.1:5000/ocr
#
# ✅ DOCKER COMPOSE (nome do serviço):
# OCR_API_URL=http://ocr-service:5000/ocr
#
# ✅ SERVIDOR REMOTO:
# OCR_API_URL=http://seu-servidor.com:5000/ocr
#

OCR_API_URL=http://localhost:5000/ocr

# Timeout em segundos para requisições à API
OCR_API_TIMEOUT=30
