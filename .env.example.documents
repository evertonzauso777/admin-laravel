# 📋 Configurações de Validação de Documentos
# Adicione estas linhas ao seu arquivo .env

# API OCR
OCR_API_URL=http://localhost:5000/ocr
OCR_API_TIMEOUT=30

# Storage
FILESYSTEM_DISK=public

# Document Validation
DOCUMENT_VALIDATION_DISK=public
DOCUMENT_VALIDATION_PATH=documents
DOCUMENT_VALIDATION_MAX_SIZE=5120 # em KB (5MB)
DOCUMENT_VALIDATION_ACCEPTED_TYPES=jpeg,png,jpg,gif

# Tipos de documentos aceitos
DOCUMENT_TYPES=RG,CNH,CPF,PASSPORT
